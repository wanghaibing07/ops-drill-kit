#!/usr/bin/env python3
"""Guarded, partial baseline deployment: install two credential drop-ins only."""
import sys
sys.dont_write_bytecode = True
import os
import hashlib
import importlib.machinery
import importlib.util
from pathlib import Path
import re
import shlex
import stat
import uuid
import argparse

import common as c

STAGE = b'[Service]\nLoadCredential=stage3-reader-password:/etc/opsdrill/orderguard-stage3-reader.password\nEnvironment=STAGE3_MYSQL_SOCKET=/var/lib/mysql/mysql.sock\n'
LEGACY = b'[Service]\nLoadCredential=mysql-password:/etc/opsdrill/orderguard-app.password\n'
VERIFY_SHA256 = '440c4d5f98f1146c62c28725760430c66f371b0a5207b0bef8c6bb821d444df8'


def copy_exclusive(dest, content, mode):
    fd = os.open(dest, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, mode)
    with os.fdopen(fd, 'wb') as stream:
        stream.write(content)
        stream.flush()
        os.fsync(stream.fileno())


def trusted_tool():
    # This check cannot undo executing an untrusted Python file: the operator
    # must place both files in a root-controlled directory before invoking it.
    for name in (__file__, c.__file__):
        path = Path(os.path.abspath(name))
        c.chain(path.parent)
        c.regular(path)


def already_configured():
    """Recognize an already loaded, matching service without writing drop-ins."""
    rc, out = c.command(['systemctl', 'show', 'orderguard-api.service', '--property=NeedDaemonReload'])
    if rc != 0 or out.strip() != b'NeedDaemonReload=no':
        return False
    path = Path(os.path.abspath(__file__)).with_name('verify')
    try:
        c.chain(path.parent)
        c.regular(path)
        data = path.read_bytes()
        if hashlib.sha256(data).hexdigest() != VERIFY_SHA256:
            return False
        loader = importlib.machinery.SourceFileLoader('opsdrill_baseline_verify', str(path))
        spec = importlib.util.spec_from_loader(loader.name, loader)
        module = importlib.util.module_from_spec(spec)
        loader.exec_module(module)
        return module.credential_settings() == 'PASS'
    except (OSError, c.Refusal, ImportError, ValueError):
        return False


def state_dir(create=False):
    c.chain(c.STATE.parent)
    if create:
        try:
            c.STATE.mkdir(mode=0o700)
        except FileExistsError:
            pass
    if os.path.lexists(c.STATE):
        c.chain(c.STATE)
        if stat.S_IMODE(c.STATE.lstat().st_mode) != 0o700:
            raise c.Refusal('状态目录必须为 root 控制且权限 0700')


def prepare_plan():
    c.guard()
    trusted_tool()
    state_dir()
    c.chain(c.DROPINS.parent)
    for path in (c.LEGACY_PASSWORD, c.READER_PASSWORD):
        c.protected(path)
    # The fixed template matches the reviewed snapshot, but is sourced from
    # this root-controlled tool, never from the devops-writable project tree.
    targets = {'30-stage3-reader.conf': STAGE, '40-baseline-legacy-credential.conf': LEGACY}
    if already_configured():
        plan = {}
        for name, content in targets.items():
            path = c.DROPINS / name
            if os.path.lexists(path):
                c.chain(path.parent)
                c.regular(path)
                plan[name] = 'same' if path.read_bytes().replace(b'\r\n', b'\n') == content else 'conflict'
            else:
                plan[name] = 'configured'
        return targets, plan
    rc, out = c.command(['systemctl', 'show', 'orderguard-api.service', '--property=LoadCredential',
                         '--property=LoadCredentialEncrypted', '--property=FragmentPath'])
    if rc != 0:
        raise c.Refusal('无法检查当前服务凭据配置')
    try:
        props = dict(line.split('=', 1) for line in out.decode('utf-8').splitlines() if '=' in line)
        fragment_text = props.get('FragmentPath', '')
        if fragment_text not in ('/etc/systemd/system/orderguard-api.service', '/usr/lib/systemd/system/orderguard-api.service'):
            raise c.Refusal('服务单元不存在或路径不受支持')
        fragment = Path(fragment_text)
        c.chain(fragment.parent)
        c.regular(fragment)
        current = shlex.split(props.get('LoadCredential', ''))
        encrypted = shlex.split(props.get('LoadCredentialEncrypted', ''))
    except (UnicodeError, ValueError):
        raise c.Refusal('无法解析当前服务凭据配置') from None
    expected = {'stage3-reader-password': 'stage3-reader-password:/etc/opsdrill/orderguard-stage3-reader.password',
                'mysql-password': 'mysql-password:/etc/opsdrill/orderguard-app.password'}
    if any(item.split(':', 1)[0] in expected for item in encrypted):
        raise c.Refusal('存在同名加密凭据')
    already = set()
    for item in current:
        ident = item.split(':', 1)[0]
        if ident in expected:
            if item != expected[ident]:
                raise c.Refusal('已有同名凭据但来源不同')
            already.add(ident)
    if os.path.lexists(c.DROPINS):
        c.chain(c.DROPINS)
        for path in c.DROPINS.glob('*.conf'):
            c.regular(path)
            if path.name not in targets:
                content = path.read_text(encoding='utf-8')
                for value in re.findall(r'^[ \t]*LoadCredential(?:Encrypted)?[ \t]*=[ \t]*([^\r\n]*)', content, re.M):
                    value = value.strip()
                    if not value or 'mysql-password' in value or 'stage3-reader-password' in value:
                        raise c.Refusal('其他 drop-in 含有相关凭据或重置配置')
    plan = {}
    for name, content in targets.items():
        path = c.DROPINS / name
        if os.path.lexists(path):
            c.regular(path)
            plan[name] = 'same' if path.read_bytes().replace(b'\r\n', b'\n') == content else 'conflict'
        elif ('stage3-reader-password' if name.startswith('30-') else 'mysql-password') in already:
            plan[name] = 'configured'
        else:
            plan[name] = 'create'
    return targets, plan


def backup_conflicts(names):
    backup_root = c.STATE / 'backups'
    try:
        backup_root.mkdir(mode=0o700)
    except FileExistsError:
        pass
    c.chain(backup_root)
    if stat.S_IMODE(backup_root.lstat().st_mode) != 0o700:
        raise c.Refusal('备份目录必须为 0700')
    run = backup_root / uuid.uuid4().hex
    run.mkdir(mode=0o700)
    for name in names:
        copy_exclusive(run / name, (c.DROPINS / name).read_bytes(), 0o600)
    return run


def run_plan(targets, plan, apply):
    for name, action in plan.items():
        print(f'{name}: {action}')
    conflicts = [name for name, action in plan.items() if action == 'conflict']
    if conflicts:
        if apply:
            print('已备份冲突文件:', backup_conflicts(conflicts))
        print('存在冲突；未覆盖，也未创建其他 drop-in。')
        return 2
    if not apply:
        print('dry-run：没有写入；--apply 才创建缺失的 drop-in。')
        return 0
    if any(action == 'create' for action in plan.values()):
        try:
            c.DROPINS.mkdir(mode=0o755)
        except FileExistsError:
            pass
        c.chain(c.DROPINS)
    for name, action in plan.items():
        if action == 'create':
            copy_exclusive(c.DROPINS / name, targets[name], 0o644)
    print('已准备 drop-in；未重载 systemd、启动服务或初始化数据库。')
    return 0


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--apply', action='store_true')
    args = parser.parse_args()
    try:
        # A dry-run makes no lock file. Apply serializes cooperating deploy runs.
        c.guard()
        trusted_tool()
        state_dir()
        if not args.apply:
            return run_plan(*prepare_plan(), False)
        import fcntl
        state_dir(create=True)
        fd = os.open(c.STATE / 'deploy.lock', os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW, 0o600)
        try:
            st = os.fstat(fd)
            if not stat.S_ISREG(st.st_mode) or st.st_uid != 0 or st.st_nlink != 1 or stat.S_IMODE(st.st_mode) != 0o600:
                raise c.Refusal('锁文件不安全')
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
            return run_plan(*prepare_plan(), True)
        finally:
            os.close(fd)
    except (c.Refusal, OSError, UnicodeError, ValueError) as exc:
        print('拒绝或失败:', str(exc) if isinstance(exc, c.Refusal) else type(exc).__name__, file=sys.stderr)
        return 1


if __name__ == '__main__':
    sys.exit(main())
